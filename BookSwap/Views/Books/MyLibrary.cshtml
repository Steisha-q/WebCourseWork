
@model IEnumerable<BookSwap.Models.Book>

@{
    ViewData["Title"] = "My Library";
var bookStatuses = ViewBag.BookStatuses
    as Dictionary<int, string>
    ?? new Dictionary<int, string>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Library</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Add Book
        </a>
    </div>
    @if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

    <div class="mb-4 d-flex gap-2">
        <a asp-action="MyLibrary"
           class="btn @(string.IsNullOrEmpty(ViewBag.Status) ? "btn-primary" : "btn-outline-primary")">
            All Books
        </a>

        <a asp-action="MyLibrary"
           asp-route-status="available"
           class="btn @(ViewBag.Status == "available" ? "btn-success" : "btn-outline-success")">
            Available
        </a>

        <a asp-action="MyLibrary"
           asp-route-status="hidden"
           class="btn @(ViewBag.Status == "hidden" ? "btn-secondary" : "btn-outline-secondary")">
            Hidden
        </a>
    </div>

    
<div class="mb-4">
    <input type="text"
           id="librarySearch"
           class="form-control"
           placeholder="Search by title or author..."
           autocomplete="off" />
</div>

<p class="text-muted" id="booksCount">
    Total: @Model.Count() books
</p>


    <div class="row">
        @foreach (var book in Model)
        {
            bookStatuses.TryGetValue(book.Id, out var swapStatus);

<div class="col-md-4 mb-4 book-item"
     data-title="@book.Title"
     data-author="@book.Author">

    <div class="card h-100 shadow-sm">


                    @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                    {
                        <img src="@book.CoverImageUrl"
                             class="card-img-top"
                             style="height:250px;object-fit:contain"
                             alt="@book.Title" />
                    }

                    <div class="card-body">
                        <h5>@book.Title</h5>
                        <p class="text-muted">@book.Author</p>

                       
@if (swapStatus == "Accepted")
{
    <span class="badge bg-warning text-dark mb-3">
        Reserved
    </span>
}
else if (swapStatus == "Completed")
{
    <span class="badge bg-primary mb-3">
        Exchanged
    </span>
}
else if (book.IsAvailable)
{
    <span class="badge bg-success mb-3">
        Available
    </span>
}
else
{
    <span class="badge bg-secondary mb-3">
        Hidden
    </span>
}


                        
<div class="d-flex gap-2 flex-wrap">

    <a asp-action="Details"
       asp-route-id="@book.Id"
       asp-route-from="library"
       class="btn btn-outline-primary btn-sm">
        View
    </a>

    @if (swapStatus != "Accepted" &&
         swapStatus != "Completed")
    {
        <a asp-action="Edit"
           asp-route-id="@book.Id"
           class="btn btn-warning btn-sm">
            Edit
        </a>

        <form asp-action="ToggleAvailability"
              asp-route-id="@book.Id"
              method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-secondary btn-sm">
                @(book.IsAvailable ? "Hide" : "Show")
            </button>
        </form>

        <form asp-action="Delete"
              asp-route-id="@book.Id"
              method="post"
              onsubmit="return confirm('Delete this book?');">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger btn-sm">
                Delete
            </button>
        </form>
    }

</div>

                    </div>
                </div>
            </div>
        }
    </div>
    
<div id="noSearchResults"
     class="text-center py-5"
     style="display:none;">

    <h4>No books found</h4>

    <p class="text-muted">
        Try searching for another title or author.
    </p>
</div>


    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h4>No books found</h4>
            <p class="text-muted">
                You have no books in this category yet.
            </p>
        </div>
    }

</div>


<script>
    const searchInput = document.getElementById("librarySearch");
    const bookItems = document.querySelectorAll(".book-item");
    const booksCount = document.getElementById("booksCount");
    const noResults = document.getElementById("noSearchResults");

    searchInput.addEventListener("input", function () {
        const searchText = this.value.trim().toLocaleLowerCase();
        let visibleCount = 0;

        bookItems.forEach(function (book) {
            const title = book.dataset.title.toLocaleLowerCase();
            const author = book.dataset.author.toLocaleLowerCase();

            const matches =
                title.includes(searchText) ||
                author.includes(searchText);

            book.style.display = matches ? "" : "none";

            if (matches) {
                visibleCount++;
            }
        });

        booksCount.textContent = "Total: " + visibleCount + " books";

        noResults.style.display =
            visibleCount === 0 && bookItems.length > 0
                ? "block"
                : "none";
    });
</script>

