@using BookSwap.Models
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Grid -->
<div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(200px,1fr)); gap:1rem; margin-bottom:2rem;">

    <div class="stat-card purple">
        <div class="stat-label">Total Users</div>
        <div class="stat-value">@ViewBag.TotalUsers</div>
        <div class="stat-sub">Registered accounts</div>
    </div>

    <div class="stat-card blue">
        <div class="stat-label">Total Books</div>
        <div class="stat-value">@ViewBag.TotalBooks</div>
        <div class="stat-sub">@ViewBag.AvailableBooks available</div>
    </div>

    <div class="stat-card orange">
        <div class="stat-label">Total Swaps</div>
        <div class="stat-value">@ViewBag.TotalSwaps</div>
        <div class="stat-sub">@ViewBag.PendingSwaps pending</div>
    </div>

    <div class="stat-card green">
        <div class="stat-label">Completed Swaps</div>
        <div class="stat-value">@ViewBag.CompletedSwaps</div>
        <div class="stat-sub">Successfully exchanged</div>
    </div>

    <div class="stat-card teal">
        <div class="stat-label">New Books (7d)</div>
        <div class="stat-value">@ViewBag.NewBooksWeek</div>
        <div class="stat-sub">Added this week</div>
    </div>

    <div class="stat-card red">
        <div class="stat-label">New Swaps (7d)</div>
        <div class="stat-value">@ViewBag.NewSwapsWeek</div>
        <div class="stat-sub">Requests this week</div>
    </div>

</div>

<!-- Quick Links -->
<div style="display:flex; gap:0.75rem; margin-bottom:2rem; flex-wrap:wrap;">
    <a href="/Admin/Admin/Users" style="
        background:rgba(124,58,237,0.15); border:1px solid rgba(124,58,237,0.3);
        color:#c4b5fd; border-radius:10px; padding:0.6rem 1.2rem;
        text-decoration:none; font-size:0.85rem; font-weight:500;
        transition:background 0.15s;" onmouseover="this.style.background='rgba(124,58,237,0.25)'"
        onmouseout="this.style.background='rgba(124,58,237,0.15)'">
        👥 Manage Users
    </a>
    <a href="/Admin/Admin/Books" style="
        background:rgba(59,130,246,0.15); border:1px solid rgba(59,130,246,0.3);
        color:#60a5fa; border-radius:10px; padding:0.6rem 1.2rem;
        text-decoration:none; font-size:0.85rem; font-weight:500;
        transition:background 0.15s;" onmouseover="this.style.background='rgba(59,130,246,0.25)'"
        onmouseout="this.style.background='rgba(59,130,246,0.15)'">
        📖 Manage Books
    </a>
    <a href="/Admin/Admin/SwapRequests" style="
        background:rgba(245,158,11,0.15); border:1px solid rgba(245,158,11,0.3);
        color:#fbbf24; border-radius:10px; padding:0.6rem 1.2rem;
        text-decoration:none; font-size:0.85rem; font-weight:500;
        transition:background 0.15s;" onmouseover="this.style.background='rgba(245,158,11,0.25)'"
        onmouseout="this.style.background='rgba(245,158,11,0.15)'">
        🔄 Manage Swaps
    </a>
</div>

<!-- Recent Swap Requests -->
<div class="admin-table-wrapper">
    <div class="admin-table-header">
        <span class="admin-table-title">Recent Swap Requests</span>
        <a href="/Admin/Admin/SwapRequests" style="font-size:0.8rem; color:#8b949e; text-decoration:none;">View all →</a>
    </div>

    @if (((IEnumerable<SwapRequest>)ViewBag.RecentSwaps).Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Sender</th>
                    <th>Receiver</th>
                    <th>Requested Book</th>
                    <th>Offered Book</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var swap in (IEnumerable<SwapRequest>)ViewBag.RecentSwaps)
                {
                    <tr>
                        <td style="color:#8b949e;">#@swap.Id</td>
                        <td>
                            <div class="user-info">
                                <div class="user-avatar">@(swap.Sender?.Email?.Substring(0,1).ToUpper() ?? "?")</div>
                                <span class="truncate" title="@swap.Sender?.Email">@swap.Sender?.Email</span>
                            </div>
                        </td>
                        <td>
                            <div class="user-info">
                                <div class="user-avatar" style="background:linear-gradient(135deg,#059669,#3b82f6)">@(swap.Receiver?.Email?.Substring(0,1).ToUpper() ?? "?")</div>
                                <span class="truncate" title="@swap.Receiver?.Email">@swap.Receiver?.Email</span>
                            </div>
                        </td>
                        <td><span class="truncate" title="@swap.RequestedBook?.Title">@swap.RequestedBook?.Title</span></td>
                        <td><span class="truncate" title="@swap.OfferedBook?.Title">@swap.OfferedBook?.Title</span></td>
                        <td>
                            <span class="badge-status badge-@swap.Status.ToLower()">@swap.Status</span>
                        </td>
                        <td style="color:#8b949e; white-space:nowrap;">@swap.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🔄</div>
            <div>No swap requests yet</div>
        </div>
    }
</div>
