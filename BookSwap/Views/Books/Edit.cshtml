
@model BookSwap.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<div class="container mt-4">
    <h2>Edit Book</h2>

    <form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data">
        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Author"></label>
            <input asp-for="Author" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Genre"></label>
            <input asp-for="Genre" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="PublicationYear"></label>
            <input asp-for="PublicationYear" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description"></label>
            <textarea asp-for="Description"
                      class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="City"></label>
            <input asp-for="City" class="form-control" />
        </div>

        

<div class="mb-3">
    <label class="form-label">Book Cover</label>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <p class="text-muted mb-2">Current cover:</p>

        <img src="@Model.CoverImageUrl"
             alt="Current book cover"
             style="max-width:180px;
                    max-height:250px;
                    object-fit:contain;"
             class="rounded border p-2 mb-3" />
    }

    <label for="coverImage" class="form-label">
        Choose New Cover
    </label>

    <input type="file"
           id="coverImage"
           name="coverImage"
           class="form-control"
           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
           onchange="previewCover(event)" />

    <div class="form-text">
        Leave empty to keep the current cover.
    </div>

    <span class="text-danger"
          data-valmsg-for="coverImage"></span>

    <div class="mt-3">
        <img id="coverPreview"
             alt="New cover preview"
             style="display:none;
                    max-width:200px;
                    max-height:280px;
                    object-fit:contain;"
             class="rounded border p-2" />
    </div>
</div>

        <div class="mb-3">
            <label asp-for="Condition"></label>
            <select asp-for="Condition" class="form-select">
                <option value="New">New</option>
                <option value="Like new">Like new</option>
                <option value="Good">Good</option>
                <option value="Worn">Worn</option>
                <option value="Damaged">Damaged</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewCover(event) {
            const file = event.target.files[0];
            const preview = document.getElementById("coverPreview");

            if (!file) {
                preview.removeAttribute("src");
                preview.style.display = "none";
                return;
            }

            if (!file.type.startsWith("image/")) {
                alert("Please select an image file.");
                event.target.value = "";
                preview.style.display = "none";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Image size must not exceed 5 MB.");
                event.target.value = "";
                preview.style.display = "none";
                return;
            }

            const reader = new FileReader();

            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = "block";
            };

            reader.readAsDataURL(file);
        }
    </script>
}

